# Copy to .env.local (gitignored) to change settings. Everything is optional.
# DIGITALOCEAN_TOKEN, GEMINI_API_KEY and NEXT_PUBLIC_REFRESH_SECONDS can also be set from the dashboard's Settings page,
# which checks them and writes them here.

# Use a specific kubeconfig file / context (defaults to the one kubectl uses).
# KUBECONFIG=/path/to/kubeconfig
# KUBE_CONTEXT=do-blr1-wldd

# Default seconds between automatic refreshes (0 = off). Each person can change it
# from the dropdown in the top bar; that choice is remembered in their browser.
NEXT_PUBLIC_REFRESH_SECONDS=30

# Live pod logs are on by default. Set to false to turn the Logs tab and its endpoint off.
# ENABLE_LOGS=false

# Optional: shows node pools and their autoscaling (min/max nodes) on the Overview, and the FinOps page. That
# information lives in DigitalOcean, not Kubernetes. Create a token at cloud.digitalocean.com/account/api with custom
# read scopes: kubernetes:read (node pools), plus billing:read and sizes:read (FinOps). It stays on this machine and
# is never sent to the browser.
# DIGITALOCEAN_TOKEN=

# Optional: the AI assistant (sidebar, "AI assistant"). Create a key at aistudio.google.com/apikey. It stays on this
# machine and is never sent to the browser. Each question sends a snapshot of the cluster (names, statuses, IPs,
# images, resource numbers and, when DIGITALOCEAN_TOKEN is set, the account's billing figures from the FinOps page;
# no environment values, Secrets or logs) to Google Gemini, so use a key you are happy to use that way. Restart the
# dev server after adding it.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash
# If that model is busy (Google answers 503 "high demand" now and then) the assistant retries once, then tries these
# lighter models in order and says which one answered. Set it empty to turn the fallback off.
# GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite
# Set to false to turn the assistant and its endpoint off.
# ENABLE_AI=false
